# build outputs
/ios/dsyms/
/bin/
/data/
server/*.test
server/coverage.out
example/

# swift
.build/
# leading ** matters: the project lives at ios/Dialler/, and a pattern
# containing a slash is anchored to the repo root without it.
**/*.xcodeproj/xcuserdata/
**/*.xcworkspace/xcuserdata/
.swiftpm/

# harness artefacts
harness/baresip/media/*.wav
harness/baresip/media/dtmf-events.txt
# TLS-trunk keys and certificates: generated by harness/tls/gen_certs.sh,
# never committed — a private key in git is a private key forever.
harness/tls/**/*.pem
harness/tls/**/*.key
harness/tls/**/*.srl

# os / editor
.DS_Store
*.swp


# UI screenshots (harness/screenshot.sh)
harness/shots/

# the product-licence vendor key (dialpark-licence keygen): offline only
vendor.key
*.vendor.key

# compiled Python from the harness helpers
__pycache__/
